<section
  class="ou-hero"
  style="--hero-bg: url('{{ 'hero-bg.png' | asset_url }}') center / cover no-repeat, {{ section.settings.bg_color }};"
>
  <div class="ou-hero__inner page-width">
    <div class="ou-hero__copy">
      {% if section.settings.eyebrow != blank %}
        <p class="badge-sticker">{{ section.settings.eyebrow | escape }}</p>
      {% endif %}
      <h1 class="ou-hero__heading">{{ section.settings.heading | escape }}</h1>
      {% if section.settings.subheading != blank %}
        <p class="ou-hero__sub">{{ section.settings.subheading | escape }}</p>
      {% endif %}
      {% if section.settings.button_label != blank %}
        <a
          class="button button--primary"
          href="{% if section.settings.button_link != blank %}{{ section.settings.button_link }}{% else %}{{ routes.all_products_collection_url }}{% endif %}"
        >
          {{ section.settings.button_label | escape }}
        </a>
      {% endif %}
    </div>

    <div class="ou-hero__media">
      {% if section.settings.image != blank %}
        {{
          section.settings.image
          | image_url: width: 1500
          | image_tag:
            class: 'ou-hero__img',
            loading: 'eager',
            widths: '375, 550, 750, 1100, 1500',
            sizes: '(min-width: 750px) 46vw, 100vw',
            alt: section.settings.image.alt
        }}
      {% else %}
        <div class="ou-hero__placeholder" aria-hidden="true">
          <span>Oddly useful</span>
        </div>
      {% endif %}
    </div>
  </div>
</section>
<div class="ou-swoosh" aria-hidden="true"></div>

{% schema %}
{
  "name": "Oddly Useful hero",
  "class": "ou-hero-section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Badge text", "default": "New drop" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Oddly useful finds" },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Things you didn't know you needed, shipped fast."
    },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop now" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "image_picker", "id": "image", "label": "Product image" },
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#fcc503" }
  ],
  "presets": [{ "name": "Oddly Useful hero" }]
}
{% endschema %}
